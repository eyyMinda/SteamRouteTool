<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <!-- The Routes screen's look: bold and game-like, built on the theme's colours so light and dark both work.
       The system accent colour is the "glow"; Auto select has its own electric blue. -->

  <Color x:Key="AutoGlowColor">#FF6A5CFF</Color>
  <!-- Glows in templates can't follow the theme live; AppTheme sets this to the Windows accent colour at startup. -->
  <Color x:Key="AccentGlowColor">#FF8A5CFF</Color>
  <LinearGradientBrush x:Key="AutoCardBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF2F7BFF" Offset="0" />
    <GradientStop Color="#FF7A4DFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Ping pill backgrounds (translucent, so they sit on any card colour). -->
  <SolidColorBrush x:Key="PingGoodBackground" Color="#2E3FBF5F" />
  <SolidColorBrush x:Key="PingFairBackground" Color="#2EE0A800" />
  <SolidColorBrush x:Key="PingPoorBackground" Color="#2EE5533D" />
  <SolidColorBrush x:Key="PingNeutralBackground" Color="#1A808080" />

  <!-- A card with a soft accent wash in its top-left corner. -->
  <Style x:Key="HeroCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,14" />
  </Style>
  <Style x:Key="AccentWash" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Opacity" Value="0.16" />
    <Setter Property="OpacityMask">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF000000" Offset="0" />
          <GradientStop Color="#00000000" Offset="0.7" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="BigNumber" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Game tabs: big titles with a glowing accent underline on the selected game. -->
  <Style x:Key="GameTab" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent" Margin="0,0,6,0">
            <Border x:Name="Hover" CornerRadius="8" Background="Transparent" Margin="0,0,0,6" />
            <ContentPresenter Margin="16,8,16,14" HorizontalAlignment="Center" />
            <Border x:Name="Underline" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="12,0" Visibility="Hidden"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.9" Color="{StaticResource AccentGlowColor}" />
              </Border.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GameTabs" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource GameTab}" />
    <Setter Property="DisplayMemberPath" Value="Name" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chips: rounded pills; the selected one is filled with the accent and glows. Used for presets and regions. -->
  <Style x:Key="Chip" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Pill" CornerRadius="16" Padding="14,6" BorderThickness="1"
                  Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
              <Setter TargetName="Pill" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.7" Color="{StaticResource AccentGlowColor}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Chips" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Chip}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChipButton" TargetType="Button">
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Pill" CornerRadius="16" Padding="12,6" BorderThickness="1" Background="Transparent"
                  BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control (status filter): one rounded group, the selected segment filled. -->
  <Style x:Key="Segment" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Segment" CornerRadius="6" Padding="12,5" Margin="2" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Segment}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border CornerRadius="8" Background="{TemplateBinding Background}">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Auto select: the electric card and its buttons. -->
  <Style x:Key="AutoCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AutoCardBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="{StaticResource AutoGlowColor}" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AutoApply" TargetType="Button">
    <Setter Property="Foreground" Value="#FF2A2470" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="White" CornerRadius="8" Padding="16,8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="#FFEDEBFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Body" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AutoStep" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Width="28" Height="28" CornerRadius="14" Background="#33FFFFFF">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="#55FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A quiet round icon button (Ping all, more actions, expand). -->
  <Style x:Key="RoundIconButton" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Body" MinWidth="34" Height="34" CornerRadius="17" Padding="9,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Body" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ping as a coloured pill; click pings again. -->
  <Style x:Key="PingPill" TargetType="Button">
    <Setter Property="ToolTip" Value="{l:Tr Routes.PingAgainTooltip}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Pill" CornerRadius="11" Padding="10,3" MinWidth="62" Background="{StaticResource PingNeutralBackground}">
            <TextBlock x:Name="Text" Text="{Binding Ping.Text}" HorizontalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Ping.Level}" Value="Good">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource PingGoodBackground}" />
              <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource PingGoodBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Ping.Level}" Value="Fair">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource PingFairBackground}" />
              <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource PingFairBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Ping.Level}" Value="Poor">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource PingPoorBackground}" />
              <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource PingPoorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Ping.Level}" Value="Failed">
              <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource PingPoorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Ping.Level}" Value="Blocked">
              <Setter TargetName="Pill" Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Ping.Level}" Value="Stale">
              <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A colour bar on a row's left edge, by ping. -->
  <Style x:Key="PingBar" TargetType="Border">
    <Setter Property="Width" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Ping.Level}" Value="Good">
        <Setter Property="Background" Value="{DynamicResource PingGoodBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Ping.Level}" Value="Fair">
        <Setter Property="Background" Value="{DynamicResource PingFairBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Ping.Level}" Value="Poor">
        <Setter Property="Background" Value="{DynamicResource PingPoorBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Ping.Level}" Value="Failed">
        <Setter Property="Background" Value="{DynamicResource PingPoorBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsBlocked}" Value="True">
        <Setter Property="Background" Value="Transparent" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Allowed / Blocked / Partly as one clickable pill (a three-state toggle bound to IsBlocked). -->
  <Style x:Key="StatePill" TargetType="ToggleButton">
    <Setter Property="ToolTip" Value="{l:Tr Routes.StateTooltip}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Pill" CornerRadius="13" Padding="12,4" MinWidth="86" BorderThickness="1"
                  Background="{StaticResource PingGoodBackground}" BorderBrush="{DynamicResource PingGoodBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource PingGoodBrush}" />
              <TextBlock x:Name="Label" Text="{l:Tr Routes.StateAllowed}" Foreground="{DynamicResource PingGoodBrush}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource PingPoorBackground}" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource PingPoorBrush}" />
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PingPoorBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PingPoorBrush}" />
              <Setter TargetName="Label" Property="Text" Value="{l:Tr Routes.StateBlocked}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource PingFairBackground}" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource PingFairBrush}" />
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PingFairBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PingFairBrush}" />
              <Setter TargetName="Label" Property="Text" Value="{l:Tr Routes.StatePartly}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Pill" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rows and cards of the server list. -->
  <Style x:Key="RouteRow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GroupHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="4,10,0,8" />
  </Style>
</ResourceDictionary>

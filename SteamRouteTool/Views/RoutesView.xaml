<UserControl x:Class="SteamRouteTool.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization"
             xmlns:routes="clr-namespace:SteamRouteTool.Views.Routes"
             xmlns:services="clr-namespace:SteamRouteTool.Services"
             SizeChanged="RoutesView_SizeChanged">
  <!-- Game tabs and headline numbers, then presets beside Auto select, then filters and the server rows. -->
  <UserControl.Resources>
    <!-- A headline ping, coloured like the ping pills (Tag = its PingLevel). -->
    <Style x:Key="PingNumber" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
      <Style.Triggers>
        <Trigger Property="Tag" Value="{x:Static services:PingLevel.Good}">
          <Setter Property="Foreground" Value="{DynamicResource PingGoodBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static services:PingLevel.Fair}">
          <Setter Property="Foreground" Value="{DynamicResource PingFairBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static services:PingLevel.Poor}">
          <Setter Property="Foreground" Value="{DynamicResource PingPoorBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel x:Name="Header" Margin="0,0,0,14" SizeChanged="Header_SizeChanged">
      <StackPanel x:Name="StatsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                  SizeChanged="Header_SizeChanged">
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="{Binding BlockedRouteCount}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource PingPoorBrush}" />
          <TextBlock Text="{l:Tr Routes.StatBlocked}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="{Binding AllowedRouteCount}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource PingGoodBrush}" />
          <TextBlock Text="{l:Tr Routes.StatAllowed}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
        <StackPanel ToolTip="{Binding BestPingTooltip}" Margin="0,0,24,0">
          <TextBlock Text="{Binding BestPingText}" Tag="{Binding BestPingLevel}" Style="{StaticResource PingNumber}" />
          <TextBlock Text="{l:Tr Routes.StatBestPing}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
        <StackPanel ToolTip="{Binding WorstPingTooltip}">
          <TextBlock Text="{Binding WorstPingText}" Tag="{Binding WorstPingLevel}" Style="{StaticResource PingNumber}" />
          <TextBlock Text="{l:Tr Routes.StatWorstPing}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </StackPanel>
      <!-- The game tabs while they fit beside the numbers; a dropdown when they don't (see Header_SizeChanged). -->
      <Grid VerticalAlignment="Center">
        <ListBox x:Name="GameTabsList" Style="{StaticResource GameTabs}" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                 AutomationProperties.Name="Game" />
        <ComboBox x:Name="GamePicker" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name"
                  FontSize="15" FontWeight="SemiBold" MinWidth="190" HorizontalAlignment="Left" Visibility="Collapsed"
                  AutomationProperties.Name="Game" />
      </Grid>
    </DockPanel>

    <!-- Compact (small window): presets as a dropdown, Auto select as a slim pill. -->
    <Grid Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource CompactOnly}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Border Style="{StaticResource HeroCard}" />
        <Border Style="{StaticResource AccentWash}" />
        <DockPanel Margin="12,8">
          <TextBlock DockPanel.Dock="Left" Text="{l:Tr Routes.Presets}" Style="{StaticResource Overline}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <routes:PresetsManager DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <TextBlock DockPanel.Dock="Left" Text="{l:Tr Routes.NoPresetsHint}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                     Visibility="{Binding HasPresets, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
          <Grid VerticalAlignment="Center" Visibility="{Binding HasPresets, Converter={StaticResource VisibleWhen}}">
            <!-- Up to 260 px, shrinking with the window. -->
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="260" />
              <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                      IsEnabled="{Binding CanChangeRules}" AutomationProperties.Name="Preset" />
            <TextBlock Text="{l:Tr Routes.PickPreset}" Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding SelectedPreset, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
          </Grid>
        </DockPanel>
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource AutoCard}" Padding="10,6" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,6,0" />
          <Button Content="−" Style="{StaticResource AutoStep}" Command="{Binding ChangeAutoRouteCountCommand}" CommandParameter="-1"
                  AutomationProperties.Name="Fewer routes" />
          <TextBlock Text="{Binding AutoRouteCount}" FontSize="15" FontWeight="Bold" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Content="+" Style="{StaticResource AutoStep}" Command="{Binding ChangeAutoRouteCountCommand}" CommandParameter="1" Margin="0,0,8,0"
                  AutomationProperties.Name="More routes" />
          <Button Content="{l:Tr AutoSelect.Button}" Command="{Binding ApplyAutoSelectCommand}" Style="{StaticResource AutoApply}"
                  ToolTip="{Binding AutoSelectPreview}" AutomationProperties.Name="Auto select" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource FullOnly}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Border Style="{StaticResource HeroCard}" />
        <Border Style="{StaticResource AccentWash}" />
        <StackPanel Margin="18,14,18,6">
          <TextBlock Text="{l:Tr Routes.Presets}" Style="{StaticResource Overline}" />
          <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                   IsEnabled="{Binding CanChangeRules}" AutomationProperties.Name="Preset" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <routes:PresetsManager />
            <TextBlock Text="{l:Tr Routes.NoPresetsHint}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding HasPresets, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <routes:AutoSelectCard Grid.Column="2" />
    </Grid>

    <routes:FilterBar Grid.Row="2" Margin="0,0,0,4" />
    <routes:Banners Grid.Row="3" />
    <routes:RouteList Grid.Row="4" />
  </Grid>
</UserControl>

<UserControl x:Class="SteamRouteTool.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title, preset and game -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
        <TextBlock Text="{l:Tr Routes.Preset}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Grid Width="200">
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                    IsEnabled="{Binding CanChangeRules}" AutomationProperties.Name="Preset"
                    ToolTip="{l:Tr Routes.PresetTooltip}" />
          <TextBlock Text="{Binding PresetPlaceholder}" Margin="12,0,36,0" VerticalAlignment="Center"
                     IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Visibility="{Binding SelectedPreset, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
        </Grid>
        <ToggleButton x:Name="PresetsButton" IsChecked="{Binding IsPresetsOpen}" Margin="6,0,0,0" Padding="9,7"
                      ToolTip="{l:Tr Routes.ManagePresetsTooltip}" AutomationProperties.Name="Manage presets">
          <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" />
        </ToggleButton>
        <TextBlock Text="{l:Tr Routes.Game}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="24,0,10,0" />
        <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name" Width="200"
                  AutomationProperties.Name="Game" ToolTip="{l:Tr Routes.GameTooltip}" />
      </StackPanel>
      <Popup x:Name="PresetsPopup" IsOpen="{Binding IsPresetsOpen}" PlacementTarget="{Binding ElementName=PresetsButton}" Placement="Custom"
             StaysOpen="False" AllowsTransparency="True" Closed="PresetsPopup_Closed">
        <Border Width="400" Padding="16" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
          <StackPanel>
            <TextBlock Text="{l:Tr Presets.SaveTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Presets.SaveDescription}" Style="{StaticResource SecondaryText}" />
            <DockPanel Margin="0,10,0,0">
              <Button DockPanel.Dock="Right" Content="{Binding SavePresetLabel}" Command="{Binding SavePresetCommand}"
                      Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="72" AutomationProperties.Name="Save preset" />
              <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" KeyDown="NewPresetName_KeyDown"
                       AutomationProperties.Name="Preset name" />
            </DockPanel>
            <TextBlock Text="{Binding PresetMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding PresetMessage, Converter={StaticResource VisibleWhen}}" />

            <TextBlock Text="{Binding PresetsTitle}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock Text="{l:Tr Presets.Empty}" Style="{StaticResource SecondaryText}"
                       Visibility="{Binding HasPresets, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                          Visibility="{Binding HasPresets, Converter={StaticResource VisibleWhen}}">
              <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <Button DockPanel.Dock="Right" Command="{Binding DeleteCommand}" Margin="8,0,0,0" Padding="9,7" VerticalAlignment="Top"
                              ToolTip="{l:Tr Presets.DeleteTooltip}" AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" />
                      </Button>
                      <StackPanel>
                        <TextBox Text="{Binding Name}" MaxLength="40" KeyDown="PresetName_KeyDown" ToolTip="{l:Tr Presets.RenameTooltip}"
                                 AutomationProperties.Name="{Binding Name, StringFormat='Rename {0}'}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Popup>
      <StackPanel>
        <TextBlock Text="{l:Tr Routes.Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,8,6" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search routes" />
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="12,0,0,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{l:Tr Routes.SearchPlaceholder}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding SearchText, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
      </Grid>
      <ComboBox Grid.Column="1" ItemsSource="{Binding RegionOptions}" SelectedValuePath="Key" DisplayMemberPath="Text" SelectedValue="{Binding SelectedRegion}" Width="160" Margin="10,0,0,0"
                AutomationProperties.Name="Region" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedValuePath="Key" DisplayMemberPath="Text" SelectedValue="{Binding SelectedStatus}" Width="140" Margin="10,0,0,0"
                AutomationProperties.Name="Status" />
      <CheckBox Grid.Column="3" Content="{l:Tr Routes.GroupByRegion}" IsChecked="{Binding GroupByRegion}" Margin="14,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="4" Content="{l:Tr Routes.ClearFilters}" Command="{Binding ClearFiltersCommand}" Margin="10,0,0,0" />
    </Grid>

    <!-- Actions; Auto select is the prominent one, on the right -->
    <DockPanel Grid.Row="2" Margin="0,0,0,4">
      <StackPanel x:Name="AutoSelectSplit" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,6">
        <Button Command="{Binding ApplyAutoSelectCommand}" Style="{StaticResource AutoSelectButton}"
                ToolTip="{l:Tr AutoSelect.Tooltip}" AutomationProperties.Name="Auto select">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr AutoSelect.Button}" />
            <TextBlock Text="{Binding AutoSelectLabel, StringFormat=' · {0}'}" FontWeight="Normal" />
          </StackPanel>
        </Button>
        <ToggleButton IsChecked="{Binding IsAutoSelectOpen}" Style="{StaticResource AutoSelectArrow}"
                      ToolTip="{l:Tr AutoSelect.OptionsTooltip}" AutomationProperties.Name="Auto select options" />
      </StackPanel>
      <Popup x:Name="AutoSelectPopup" IsOpen="{Binding IsAutoSelectOpen}" PlacementTarget="{Binding ElementName=AutoSelectSplit}" Placement="Custom"
             StaysOpen="False" AllowsTransparency="True">
        <Border Width="380" Padding="16" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
          <StackPanel>
            <TextBlock Text="{l:Tr AutoSelect.Button}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr AutoSelect.Description}" Style="{StaticResource SecondaryText}" />
            <DockPanel Margin="0,12,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding AutoRouteCountText}" MinWidth="70"
                         TextAlignment="Right" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Left" Text="{l:Tr AutoSelect.KeepFastest}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      Value="{Binding AutoRouteCount, Delay=200}" AutomationProperties.Name="Routes to keep" />
            </DockPanel>
            <TextBlock Text="{Binding AutoSelectPreview}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button Content="{l:Tr Common.Apply}" Style="{StaticResource AutoSelectButton}" Tag="4" Command="{Binding ApplyAutoSelectCommand}"
                    HorizontalAlignment="Right" Margin="0,12,0,0" AutomationProperties.Name="Apply auto select" />
          </StackPanel>
        </Border>
      </Popup>
      <WrapPanel>
        <Button Command="{Binding PingAllCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,6"
                ToolTip="{l:Tr Routes.PingAllTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr Routes.PingAll}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RefreshCommand}" Margin="0,0,12,6" ToolTip="{l:Tr Routes.RefreshTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr Routes.Refresh}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BlockAllExceptShownCommand}" Margin="0,0,8,6"
                ToolTip="{l:Tr Routes.BlockAllExceptShownTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr Routes.BlockAllExceptShown}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding UnblockAllCommand}" Margin="0,0,8,6" ToolTip="{l:Tr Routes.UnblockAllTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr Routes.UnblockAll}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BlockAllCommand}" Margin="0,0,8,6" ToolTip="{l:Tr Routes.BlockAllTooltip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr Routes.BlockAll}" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </DockPanel>

    <!-- Progress and messages -->
    <StackPanel Grid.Row="3">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                   Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
      <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
              Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{l:Tr Common.Dismiss}" Command="{Binding DismissMessagesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="{l:Tr Common.Retry}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
              Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhen}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{l:Tr Common.Dismiss}" Command="{Binding DismissMessagesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="{l:Tr Common.Undo}" Command="{Binding UndoCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding CanUndo, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Undo" />
          <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- Route list -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0">
      <Grid>
        <DataGrid x:Name="RoutesGrid" ItemsSource="{Binding RoutesView}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                  BorderThickness="0" Background="Transparent" RowDetailsVisibilityMode="Collapsed"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                  LoadingRow="RoutesGrid_LoadingRow" SizeChanged="RoutesGrid_SizeChanged" AutomationProperties.Name="Routes">
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Margin="16,14,0,4" FontWeight="SemiBold">
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </TextBlock>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </DataGrid.GroupStyle>

          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40" MinWidth="40" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ToggleButton IsChecked="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExpandToggle}"
                                Visibility="{Binding HasMultipleRelays, Converter={StaticResource VisibleWhen}}"
                                ToolTip="{l:Tr Routes.ShowRelaysTooltip}" AutomationProperties.Name="Show relays" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Sized to fill the remaining width in code-behind: a "*" width squeezes the other columns when rows are grouped. -->
            <DataGridTemplateColumn x:Name="RouteColumn" Header="{l:Tr Routes.ColumnRoute}" Width="220" MinWidth="220" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12">
                      <Run Text="{Binding Code, Mode=OneWay}" />
                      <Run Text="{Binding BlockedDetail, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{l:Tr Routes.ColumnRegion}" Width="140" MinWidth="140" SortMemberPath="RegionOrder">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RegionName}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{l:Tr Routes.ColumnRelays}" Width="80" MinWidth="80" SortMemberPath="RelayCount">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RelayCount}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{l:Tr Routes.ColumnPing}" Width="110" MinWidth="110" SortMemberPath="PingSortValue">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Command="{Binding PingAgainCommand}" Style="{StaticResource PingButton}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PingText}" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{l:Tr Routes.ColumnBlocked}" Width="90" MinWidth="90" SortMemberPath="BlockedSortValue">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                            IsEnabled="{Binding DataContext.CanChangeRules, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            ToolTip="{l:Tr Routes.BlockRouteTooltip}" AutomationProperties.Name="Block route" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>

          <!-- Relays of an expanded route; the last two columns line up with Ping and Blocked. -->
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Relays}" Margin="40,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Endpoint}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Command="{Binding PingAgainCommand}" Style="{StaticResource PingButton}">
                        <TextBlock Style="{StaticResource PingText}" />
                      </Button>
                      <CheckBox Grid.Column="3" IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                IsEnabled="{Binding DataContext.CanChangeRules, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                ToolTip="{l:Tr Routes.BlockRelayTooltip}" AutomationProperties.Name="Block relay" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Empty state when the filters hide everything -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoShownRoutes, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{l:Tr Routes.NoMatches}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
          <Button Content="{l:Tr Routes.ClearFilters}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

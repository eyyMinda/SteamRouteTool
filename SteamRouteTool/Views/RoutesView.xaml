<UserControl x:Class="SteamRouteTool.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title and game -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
        <TextBlock Text="Game" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name" Width="220"
                  AutomationProperties.Name="Game" ToolTip="Each game keeps its own saved set of blocked routes" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Routes" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,8,6" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search routes" />
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="12,0,0,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="Search by name, code or region" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding SearchText, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
      </Grid>
      <ComboBox Grid.Column="1" ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding SelectedRegion}" Width="160" Margin="10,0,0,0"
                AutomationProperties.Name="Region" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="140" Margin="10,0,0,0"
                AutomationProperties.Name="Status" />
      <CheckBox Grid.Column="3" Content="Group by region" IsChecked="{Binding GroupByRegion}" Margin="14,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="4" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="10,0,0,0" />
    </Grid>

    <!-- Actions -->
    <WrapPanel Grid.Row="2" Margin="0,0,0,4">
      <Button Command="{Binding PingAllCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,6"
              ToolTip="Ping every route again">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Ping all" />
        </StackPanel>
      </Button>
      <Button Command="{Binding RefreshCommand}" Margin="0,0,20,6" ToolTip="Reload the route list from Steam and re-read the firewall rules">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Refresh routes" />
        </StackPanel>
      </Button>
      <Button Command="{Binding ToggleAutoSelectCommand}" Margin="0,0,8,6"
              ToolTip="Keep only the fastest routes by ping and block the rest" AutomationProperties.Name="Auto select">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Auto select" />
        </StackPanel>
      </Button>
      <Button Command="{Binding BlockAllExceptShownCommand}" Margin="0,0,8,6"
              ToolTip="Keep only the routes the search and filters show (e.g. one region) and block all others">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Block all except shown" />
        </StackPanel>
      </Button>
      <Button Command="{Binding UnblockAllCommand}" Margin="0,0,8,6" ToolTip="Unblock every route and remove all of the tool's firewall rules">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Unblock all" />
        </StackPanel>
      </Button>
      <Button Command="{Binding BlockAllCommand}" Margin="0,0,8,6" ToolTip="Block every route">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Block all" />
        </StackPanel>
      </Button>
    </WrapPanel>

    <!-- Auto select, progress and messages -->
    <StackPanel Grid.Row="3">
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,8"
              Visibility="{Binding IsAutoSelectOpen, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Text="Auto select" FontWeight="SemiBold" />
          <TextBlock Text="Keeps the fastest routes by their best known ping and blocks every other route."
                     Style="{StaticResource SecondaryText}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Keep routes with a ping up to" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="20" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding AutoMaxPingMs, Delay=200}" AutomationProperties.Name="Maximum ping" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AutoMaxPingMs, StringFormat='{}{0} ms'}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Always keep at least" VerticalAlignment="Center" Margin="0,8,16,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,8,0,0"
                    Value="{Binding AutoMinRoutes, Delay=200}" AutomationProperties.Name="Minimum routes" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AutoMinRoutes, StringFormat='{}{0} fastest'}" VerticalAlignment="Center" Margin="12,8,0,0" />
          </Grid>
          <TextBlock Text="{Binding AutoSelectPreview}" TextWrapping="Wrap" Margin="0,12,0,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding ToggleAutoSelectCommand}" Margin="0,0,8,0" />
            <Button Content="Apply" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ApplyAutoSelectCommand}"
                    AutomationProperties.Name="Apply auto select" />
          </StackPanel>
        </StackPanel>
      </Border>
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                   Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
      <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
              Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissMessagesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
              Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhen}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissMessagesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- Route list -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0">
      <Grid>
        <DataGrid x:Name="RoutesGrid" ItemsSource="{Binding RoutesView}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                  BorderThickness="0" Background="Transparent" RowDetailsVisibilityMode="Collapsed"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                  LoadingRow="RoutesGrid_LoadingRow" SizeChanged="RoutesGrid_SizeChanged" AutomationProperties.Name="Routes">
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Margin="16,14,0,4" FontWeight="SemiBold">
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </TextBlock>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </DataGrid.GroupStyle>

          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40" MinWidth="40" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ToggleButton IsChecked="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExpandToggle}"
                                Visibility="{Binding HasMultipleRelays, Converter={StaticResource VisibleWhen}}"
                                ToolTip="Show this route's relays to block them individually" AutomationProperties.Name="Show relays" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Sized to fill the remaining width in code-behind: a "*" width squeezes the other columns when rows are grouped. -->
            <DataGridTemplateColumn x:Name="RouteColumn" Header="Route" Width="220" MinWidth="220" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12">
                      <Run Text="{Binding Code, Mode=OneWay}" />
                      <Run Text="{Binding BlockedDetail, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Region" Width="140" MinWidth="140" SortMemberPath="RegionOrder">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Region}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Relays" Width="80" MinWidth="80" SortMemberPath="RelayCount">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RelayCount}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Ping" Width="110" MinWidth="110" SortMemberPath="PingSortValue">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Command="{Binding PingAgainCommand}" Style="{StaticResource PingButton}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PingText}" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Blocked" Width="90" MinWidth="90" SortMemberPath="BlockedSortValue">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                            IsEnabled="{Binding DataContext.CanChangeRules, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            ToolTip="Block this route in Windows Firewall" AutomationProperties.Name="Block route" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>

          <!-- Relays of an expanded route; the last two columns line up with Ping and Blocked. -->
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Relays}" Margin="40,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Endpoint}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Command="{Binding PingAgainCommand}" Style="{StaticResource PingButton}">
                        <TextBlock Style="{StaticResource PingText}" />
                      </Button>
                      <CheckBox Grid.Column="3" IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                IsEnabled="{Binding DataContext.CanChangeRules, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                ToolTip="Block only this relay" AutomationProperties.Name="Block relay" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Empty state when the filters hide everything -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoShownRoutes, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="No routes match your search and filters." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
          <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

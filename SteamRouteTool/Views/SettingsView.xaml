<UserControl x:Class="SteamRouteTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="{l:Tr Settings.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <ComboBox DockPanel.Dock="Right" Margin="24,0,0,0" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name"
                    Width="200" VerticalAlignment="Center" AutomationProperties.Name="Language" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.Language}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.LanguageDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <ComboBox DockPanel.Dock="Right" Margin="24,0,0,0" ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Key" DisplayMemberPath="Text"
                    SelectedValue="{Binding Theme}" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Theme" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.Theme}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.ThemeDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <CheckBox DockPanel.Dock="Right" Margin="24,0,0,0" IsChecked="{Binding PingOnStartup}" VerticalAlignment="Center" AutomationProperties.Name="Ping routes automatically" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.PingAuto}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.PingAutoDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <CheckBox DockPanel.Dock="Right" Margin="24,0,0,0" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeStartup}"
                    VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.StartWithWindows}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.StartWithWindowsDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <CheckBox DockPanel.Dock="Right" Margin="24,0,0,0" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" AutomationProperties.Name="Minimize to tray" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.MinimizeToTray}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.MinimizeToTrayDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <CheckBox DockPanel.Dock="Right" Margin="24,0,0,0" IsChecked="{Binding UnblockOnExit}" VerticalAlignment="Center" AutomationProperties.Name="Unblock all routes when closing" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.UnblockOnExit}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.UnblockOnExitDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Margin="24,0,0,0" Content="{l:Tr Settings.OpenFolder}" Command="{Binding OpenSettingsFolderCommand}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.Folder}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.FolderDescription}" Style="{StaticResource SecondaryText}" />
            <TextBox Text="{Binding SettingsFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" Padding="0,4" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Margin="24,0,0,0" Content="{l:Tr Settings.OpenFirewall}" Command="{Binding OpenFirewallCommand}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="{l:Tr Settings.FirewallRules}" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr Settings.FirewallRulesDescription}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

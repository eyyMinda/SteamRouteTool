<UserControl x:Class="SteamRouteTool.Views.HowToView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <!-- Quick start as four step cards, then the details as collapsed sections. The texts are in Strings/<language>.json;
       **double asterisks** there mark bold words. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1024" HorizontalAlignment="Center">
      <StackPanel.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
          <Setter Property="Width" Value="28" />
          <Setter Property="Height" Value="28" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PingDot" TargetType="Ellipse">
          <Setter Property="Width" Value="10" />
          <Setter Property="Height" Value="10" />
          <Setter Property="Margin" Value="0,0,8,0" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A collapsible card: the header row (icon, title, chevron) toggles the text below it. -->
        <Style x:Key="Topic" TargetType="Expander">
          <Setter Property="Margin" Value="0,0,0,6" />
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Expander">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                  <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="16,11">
                            <DockPanel>
                              <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"
                                         VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Body" Margin="16,10,16,6" Visibility="Collapsed" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="TopicBody" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </StackPanel.Resources>

      <TextBlock Text="{l:Tr HowTo.Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{l:Tr HowTo.WhatItDoes1}" Style="{StaticResource SecondaryText}" Margin="0,4,0,20" />

      <!-- Quick start -->
      <TextBlock Text="{l:Tr HowTo.QuickStart}" Style="{StaticResource SettingsHeading}" />
      <UniformGrid Rows="1" Margin="-4,0,-4,4">
        <Border Style="{StaticResource Card}" Margin="4,0,4,8">
          <StackPanel>
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="1" Style="{StaticResource StepNumberText}" />
            </Border>
            <TextBlock Text="{l:Tr HowTo.Step1Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="{l:Tr HowTo.Step1Text}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="4,0,4,8">
          <StackPanel>
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="2" Style="{StaticResource StepNumberText}" />
            </Border>
            <TextBlock Text="{l:Tr HowTo.Step2Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <Ellipse Style="{StaticResource PingDot}" Fill="{DynamicResource PingGoodBrush}" />
              <TextBlock Text="{l:Tr HowTo.PingGood}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <Ellipse Style="{StaticResource PingDot}" Fill="{DynamicResource PingFairBrush}" />
              <TextBlock Text="{l:Tr HowTo.PingFair}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <Ellipse Style="{StaticResource PingDot}" Fill="{DynamicResource PingPoorBrush}" />
              <TextBlock Text="{l:Tr HowTo.PingPoor}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="4,0,4,8">
          <StackPanel>
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="3" Style="{StaticResource StepNumberText}" />
            </Border>
            <TextBlock Text="{l:Tr HowTo.Step3Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="{l:Tr HowTo.Step3Text}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="4,0,4,8">
          <StackPanel>
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="4" Style="{StaticResource StepNumberText}" />
            </Border>
            <TextBlock Text="{l:Tr HowTo.Step4Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="{l:Tr HowTo.Step4Text}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <DockPanel Margin="0,0,0,24">
        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Margin="2,2,10,0" VerticalAlignment="Top"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock l:RichText.Text="{l:Tr HowTo.WhenDone}" Style="{StaticResource SecondaryText}" />
      </DockPanel>

      <TextBlock Text="{l:Tr HowTo.CommonQuestions}" Style="{StaticResource SettingsHeading}" />
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqVac}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.FaqVacAnswer}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqAdmin}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.FaqAdminAnswer}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqLowerPing}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.FaqLowerPingAnswer}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqQueue}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.FaqQueueAnswer}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqModes}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.FaqModesAnswer}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqPrivacy}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.FaqPrivacyAnswer}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>

      <TextBlock Text="{l:Tr HowTo.MoreDetails}" Style="{StaticResource SettingsHeading}" />
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqRegion}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking1}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqAutoSelect}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking2}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8A4;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqRelays}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking3}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqSorting}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking4}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.Presets}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Presets1}" Style="{StaticResource TopicBody}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Presets2}" Style="{StaticResource TopicBody}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Presets3}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.AutoPreset}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.AutoPresetText}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.Profiles}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Profiles1}" Style="{StaticResource TopicBody}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Profiles2}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.Pings}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Pings1}" Style="{StaticResource TopicBody}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Pings2}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.Background}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Background1}" Style="{StaticResource TopicBody}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Background2}" Style="{StaticResource TopicBody}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Background3}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.Shortcuts}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.ShortcutsText}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>

      <TextBlock Text="{l:Tr HowTo.Troubleshooting}" Style="{StaticResource SettingsHeading}" />
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqFirewallError}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting1}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqStillConnected}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting2}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqSeeRules}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting3}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.FaqSmartScreen}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting4}" Style="{StaticResource TopicBody}" />
        </StackPanel>
      </Expander>
      <Expander Style="{StaticResource Topic}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr HowTo.Removing}" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="28,0,0,0">
          <TextBlock l:RichText.Text="{l:Tr HowTo.Removing1}" Style="{StaticResource TopicBody}" />
          <TextBox Text="{Binding SettingsFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>

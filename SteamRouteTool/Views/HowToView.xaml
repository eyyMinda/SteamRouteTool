<UserControl x:Class="SteamRouteTool.Views.HowToView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <!-- The texts are in Strings/<language>.json; **double asterisks** there mark bold words. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="{l:Tr HowTo.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.WhatItDoes}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.WhatItDoes1}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.GettingStarted}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Step1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Step2}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Step3}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Step4}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Step5}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Blocking}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking2}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking3}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Blocking4}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Presets}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Presets1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Presets2}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Presets3}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Profiles}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Profiles1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Profiles2}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Pings}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Pings1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Pings2}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Background}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Background1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Background2}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Troubleshooting}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting1}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting2}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting3}" Style="{StaticResource BodyText}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Troubleshooting4}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr HowTo.Removing}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr HowTo.Removing1}" Style="{StaticResource BodyText}" />
          <TextBox Text="{Binding SettingsFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

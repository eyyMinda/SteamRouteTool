<UserControl x:Class="SteamRouteTool.Views.Routes.Banners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <!-- Progress, errors (with Retry) and results (with Undo). -->
  <StackPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
    <!-- Windows Firewall off: blocking does nothing until it's back on. Stays until a check finds it on again. -->
    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
            Visibility="{Binding FirewallWarning, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Tr Firewall.CheckAgain}" Command="{Binding CheckFirewallCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="{l:Tr Firewall.Open}" Command="{Binding OpenFirewallSettingsCommand}" Margin="8,0,0,0"
                VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}" />
        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
        <TextBlock Text="{Binding FirewallWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <!-- Locations Valve added: allowed (with Block) or already blocked by the setting. -->
    <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
            Visibility="{Binding NewRoutesMessage, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Tr Common.Dismiss}" Command="{Binding DismissNewRoutesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="{l:Tr NewRoutes.Block}" Command="{Binding BlockNewRoutesCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                Style="{DynamicResource AccentButtonStyle}" Visibility="{Binding CanBlockNewRoutes, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
        <TextBlock Text="{Binding NewRoutesMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
            Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Tr Common.Dismiss}" Command="{Binding DismissMessagesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="{l:Tr Common.Retry}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,10,0" />
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
            Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Tr Common.Dismiss}" Command="{Binding DismissMessagesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="{l:Tr Common.Undo}" Command="{Binding UndoCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding CanUndo, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Undo" />
        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>

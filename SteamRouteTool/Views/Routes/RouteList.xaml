<UserControl x:Class="SteamRouteTool.Views.Routes.RouteList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization"
             x:Name="Root">
  <!-- The servers as rounded rows: ping colour bar, place, ping pill and Allowed/Blocked pill; expand for single relays. -->
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <ItemsControl ItemsSource="{Binding RoutesView}" AutomationProperties.Name="Routes">
        <ItemsControl.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource GroupHeader}">
                  <Run Text="{Binding Name, Mode=OneWay}" />
                  <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" />
                </TextBlock>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource RouteRow}">
              <StackPanel>
                <Grid Margin="0,8,12,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource PingBar}" Margin="6,2,6,2" />
                  <ToggleButton Grid.Column="1" IsChecked="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExpandToggle}"
                                Visibility="{Binding HasMultipleRelays, Converter={StaticResource VisibleWhen}}"
                                ToolTip="{l:Tr Routes.ShowRelaysTooltip}" AutomationProperties.Name="Show relays" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding City, Mode=OneWay}" />
                      <Run Text="{Binding Country, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12">
                      <Run Text="{Binding RegionName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Code, Mode=OneWay}" /><Run Text="{Binding BlockedDetail, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding RelayCountText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0" />
                  <Button Grid.Column="4" Command="{Binding PingAgainCommand}" Style="{StaticResource PingPill}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ToggleButton Grid.Column="5" Style="{StaticResource StatePill}" IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding DataContext.CanChangeRules, ElementName=Root}" VerticalAlignment="Center"
                                AutomationProperties.Name="Block route" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Relays}" Margin="46,0,12,8"
                              Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhen}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Endpoint}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding PingAgainCommand}" Style="{StaticResource PingPill}" Margin="0,0,10,0" />
                        <ToggleButton Grid.Column="3" Style="{StaticResource StatePill}" IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding DataContext.CanChangeRules, ElementName=Root}" AutomationProperties.Name="Block relay" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Empty state when the filters hide everything -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding HasNoShownRoutes, Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="{l:Tr Routes.NoMatches}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
      <Button Content="{l:Tr Routes.ClearFilters}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>
  </Grid>
</UserControl>

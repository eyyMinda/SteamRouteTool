<UserControl x:Class="SteamRouteTool.Views.Routes.AutoSelectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization">
  <!-- Auto select as an electric card: keep [−] N [+] fastest, Apply. The preview is the Apply button's tooltip. -->
  <Border Style="{StaticResource AutoCard}">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,8,0" />
        <TextBlock Text="{l:Tr AutoSelect.Button}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{l:Tr AutoSelect.Description}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="{l:Tr Common.Apply}" Command="{Binding ApplyAutoSelectCommand}" Style="{StaticResource AutoApply}"
                ToolTip="{Binding AutoSelectPreview}" AutomationProperties.Name="Auto select" />
        <TextBlock Text="{l:Tr AutoSelect.Keep}" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.85" />
        <Button Content="−" Style="{StaticResource AutoStep}" Command="{Binding ChangeAutoRouteCountCommand}" CommandParameter="-1"
                AutomationProperties.Name="Fewer routes" />
        <TextBlock Text="{Binding AutoRouteCount}" FontSize="20" FontWeight="Bold" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" />
        <Button Content="+" Style="{StaticResource AutoStep}" Command="{Binding ChangeAutoRouteCountCommand}" CommandParameter="1"
                AutomationProperties.Name="More routes" />
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>

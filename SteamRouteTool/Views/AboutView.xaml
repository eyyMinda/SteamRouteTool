<UserControl x:Class="SteamRouteTool.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SteamRouteTool.Localization"
             xmlns:services="clr-namespace:SteamRouteTool.Services">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="{l:Tr About.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="/wifi.ico" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="Steam Route Tool" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionLine}" Style="{StaticResource SecondaryText}" />
            <TextBlock Text="{l:Tr About.Tagline}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <Button Content="{l:Tr About.DownloadUpdate}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding OpenLinkCommand}" CommandParameter="{Binding UpdateUrl}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource VisibleWhen}}" />
            <Button Content="{l:Tr About.CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{l:Tr About.Updates}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr About.Links}" Style="{StaticResource SectionTitle}" />
          <WrapPanel>
            <Button Content="{l:Tr About.Changelog}" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppInfo.ChangelogUrl}" Margin="0,0,8,8" />
            <Button Content="{l:Tr About.Releases}" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppInfo.ReleasesUrl}" Margin="0,0,8,8" />
            <Button Content="{l:Tr About.Source}" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppInfo.RepositoryUrl}" Margin="0,0,8,8" />
            <Button Content="{l:Tr About.Report}" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppInfo.IssuesUrl}" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr About.Credits}" Style="{StaticResource SectionTitle}" />
          <TextBlock l:RichText.Text="{l:Tr About.CreditFroody}" Style="{StaticResource BodyText}" Margin="0,0,0,2" />
          <TextBlock Style="{StaticResource BodyText}">
            <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppInfo.OriginalRepositoryUrl}">
              <Run Text="{l:Tr About.OriginalProject}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock l:RichText.Text="{l:Tr About.CreditEyyMinda}" Style="{StaticResource BodyText}" />
          <TextBlock Style="{StaticResource BodyText}">
            <Run Text="{l:Tr About.CreditIcon}" />
            <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/feathericons/feather">Feather icons</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr About.License}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{l:Tr About.LicenseText}" Style="{StaticResource BodyText}" Margin="0,0,0,2" />
          <TextBlock Style="{StaticResource BodyText}">
            <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppInfo.LicenseUrl}">
              <Run Text="{l:Tr About.ReadLicense}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock Text="{l:Tr About.Trademarks}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

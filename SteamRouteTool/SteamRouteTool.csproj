<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SteamRouteTool</RootNamespace>
    <AssemblyName>SteamRouteTool</AssemblyName>
    <ApplicationIcon>wifi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.4</Version>
    <Product>Steam Route Tool</Product>
    <AssemblyTitle>A tool for blocking routes in Steam games that use Valve's SDR network config</AssemblyTitle>
    <Company>Froody, eyyMinda</Company>
    <Authors>Froody, eyyMinda</Authors>
    <Copyright>Copyright © 2019 Froody, © 2026 eyyMinda</Copyright>
    <!-- Keep ProductVersion (shown in the About dialog) as the plain version, without a +commit suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SteamRouteTool</RootNamespace>
    <AssemblyName>SteamRouteTool</AssemblyName>
    <ApplicationIcon>wifi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF0001: Application.ThemeMode (the Windows 11 Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="wifi.ico" />
    <!-- Translations, loaded by Localization/Loc.cs as "SteamRouteTool.Strings.<code>.json". -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="SteamRouteTool.Strings.%(Filename).json" WithCulture="false" />
    <InternalsVisibleTo Include="SteamRouteTool.Tests" />
    <!-- Lets the updater download the same kind of exe: the self-contained one or the small one that needs .NET. -->
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
    <!-- WPF leaves these out of the implicit usings (System.IO.Path clashes with System.Windows.Shapes.Path, which isn't used here). -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <PropertyGroup>
    <Version>2.1.5</Version>
    <Product>Steam Route Tool</Product>
    <AssemblyTitle>Choose which Valve relay locations your games can connect to</AssemblyTitle>
    <Company>Froody, eyyMinda</Company>
    <Authors>Froody, eyyMinda</Authors>
    <Copyright>Copyright © 2019 Froody, © 2026 eyyMinda</Copyright>
    <!-- Keep the version shown in the app as the plain version, without a +commit suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Download size. The app has its own translations (Strings/), so .NET's translated framework messages aren't
       needed (about 3.4 MB). Trimming would save more, but WPF doesn't support it. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
